# Lingxi V1.1 local runtime configuration template.
# Copy this file to .env and fill in local secrets. Do not commit .env.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Lingxi Knowledge Base
APP_ENV=development
# Structured JSON logs by default (LOG_FORMAT=text for human-friendly local dev).
LOG_LEVEL=INFO
LOG_FORMAT=json
# Comma-separated browser origins allowed by CORS. Use "*" only for open dev
# (credentials are disabled automatically when "*" is present).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
# Optional full SQLAlchemy database URL. If empty, config.py builds it from the
# POSTGRES_* values below.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lingxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Connection pool (applied to PostgreSQL only; SQLite uses its default pool).
# DB_ROLE is set to "worker" automatically inside the Celery worker process so
# it can be sized independently; WORKER_DB_* override the shared DB_* values.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
WORKER_DB_POOL_SIZE=10
WORKER_DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Optional full Redis URL. If empty, config.py builds it from Redis parts below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
# Optional full Redis URLs. If empty, config.py builds them from Redis parts.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULT_DB=2
CELERY_QUEUE_NAMES=parse,qa,embedding,maintenance
CELERY_DEFAULT_QUEUE=maintenance
CELERY_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Object storage / Upload
# -----------------------------------------------------------------------------
# Storage backend for original files and parse artifacts. V1.1 local mode uses
# local filesystem storage; MinIO is reserved for deployment integration.
OBJECT_STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.data/object-storage

# Upload validation. When UPLOAD_ALLOWED_EXTENSIONS is unset the effective
# allowlist is derived from the available parsers (md/txt/csv always; pdf/docx/
# pptx/xlsx/png/jpg only when MINERU_BASE_URL is configured). Setting it can
# only RESTRICT that list, never widen it. Include the leading dot.
#UPLOAD_ALLOWED_EXTENSIONS=.md,.markdown,.txt
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
IMPORT_MAX_FILES_PER_JOB=1

# -----------------------------------------------------------------------------
# MinerU document parsing service (PDF / Office / images)
# -----------------------------------------------------------------------------
# Base URL of a self-hosted mineru-api (or mineru-router) instance, e.g.
# http://localhost:8888 — see https://opendatalab.github.io/MinerU/.
# Leave empty to disable: PDF/Office/image uploads are then rejected at the
# upload gate instead of failing later at the parse stage.
MINERU_BASE_URL=
# Optional bearer token if the MinerU service sits behind an auth proxy.
MINERU_API_KEY=
# Per-HTTP-call timeout; a large-document parse may span many poll calls.
MINERU_TIMEOUT_MS=30000
# Overall deadline for one document parse (submit + poll), in seconds.
MINERU_MAX_WAIT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=3.0
# Optional passthrough options for mineru-api (backend: pipeline/vlm..., lang).
MINERU_BACKEND=
MINERU_LANG=

# -----------------------------------------------------------------------------
# Docling document parsing service (second heavy engine: PDF / Office / images / HTML)
# -----------------------------------------------------------------------------
# Heavy-parser engine selection: auto (default) registers both engines with
# MinerU taking precedence for their shared formats (Docling then only
# receives .html/.htm); "mineru" or "docling" registers that engine only.
DOC_PARSER_ENGINE=auto
# Base URL of a self-hosted docling-serve instance (default port 5001), e.g.
# http://localhost:5001 — see https://github.com/docling-project/docling-serve.
# Leave empty to disable; Docling-only formats are then rejected at upload.
DOCLING_BASE_URL=
# Sent as X-Api-Key when the server sets DOCLING_SERVE_API_KEY.
DOCLING_API_KEY=
# Per-HTTP-call timeout; overall parse deadline; long-poll interval.
DOCLING_TIMEOUT_MS=30000
DOCLING_MAX_WAIT_SECONDS=600
DOCLING_POLL_INTERVAL_SECONDS=3.0
# Optional passthrough form fields for docling-serve (raw strings).
#DOCLING_DO_OCR=true
#DOCLING_OCR_LANG=zh
#DOCLING_PDF_BACKEND=dlparse_v4

# -----------------------------------------------------------------------------
# Processing / batching (large documents)
# -----------------------------------------------------------------------------
# QA split packs chunks into prompts bounded by this char budget (token proxy),
# and fans generation out across at most N concurrent model calls.
QA_SPLIT_MAX_BATCH_CHARS=6000
QA_SPLIT_MAX_CONCURRENCY=4
# Embedding runs in batches of EMBEDDING_BATCH_SIZE questions, across at most
# EMBEDDING_MAX_CONCURRENCY concurrent calls; each batch retries transient
# failures up to EMBEDDING_BATCH_MAX_RETRIES times before failing the job.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_BATCH_MAX_RETRIES=2

# Seconds of silence on a chat SSE stream before a keep-alive comment is sent,
# so idle proxies/gateways do not cut off long retrieval/generation gaps.
SSE_HEARTBEAT_SECONDS=15

# -----------------------------------------------------------------------------
# Authentication / Token secrets
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY signs access/refresh tokens. SECRET_ENCRYPTION_KEY encrypts
# model-provider API keys at rest. They are INDEPENDENT — there is no fallback
# from one to the other, so both must be set and they MUST be different values.
#
# In production (APP_ENV=production) the backend refuses to start unless both
# keys are set, at least 32 chars long, and distinct (see validate_secret_config).
# Generate strong random keys, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-local-dev
SECRET_ENCRYPTION_KEY=change-me-in-local-dev-encryption
JWT_ALGORITHM=HS256
# iss/aud claims are validated on every token; keep them stable across the fleet.
JWT_ISSUER=lingxi
JWT_AUDIENCE=lingxi-api
ACCESS_TOKEN_MINUTES=30
# Refresh lifetime (minutes); default 14 days. Logout / password change / disable
# revoke all outstanding tokens immediately via the user's token_version.
REFRESH_TOKEN_MINUTES=20160

# -----------------------------------------------------------------------------
# Seed data
# -----------------------------------------------------------------------------
SEED_TENANT_NAME=Default Tenant
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=Employee123!

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_DEFAULT_LOGIN_EMAIL=admin@example.com
VITE_DEFAULT_LOGIN_PASSWORD=Admin123!
API_PORT=8000
WEB_ADMIN_PORT=5173
